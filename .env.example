# Imagine AI Environment Configuration Template
# Copy this file to .env or .env.local and replace with your actual keys.
# Note: Vite only exposes variables that start with VITE_.

# RapidAPI ChatGPT-42 Text-to-Image API Keys (Multiple keys supported for fallback key rotation)
VITE_GPT_API_KEY1=your_rapidapi_key_here
VITE_GPT_API_KEY2=
VITE_GPT_API_KEY3=
VITE_GPT_API_KEY4=
VITE_GPT_API_KEY5=
VITE_GPT_API_KEY6=
VITE_GPT_API_KEY7=
VITE_GPT_API_KEY8=
VITE_GPT_API_KEY9=
VITE_GPT_API_KEY10=

# Optional OpenAI API Key (DALL-E fallback provider if RapidAPI fails)
VITE_OPENAI_API_KEY=
